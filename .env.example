# ==============================================================================
# TALLER DE TORNO MORALES LÓPEZ - SISTEMA DE RECURSOS HUMANOS
# Variables de Entorno para Despliegue de Producción (Docker Compose)
# ==============================================================================

# ── Configuración de Base de Datos PostgreSQL ─────────────────────────────────
POSTGRES_DB=tornomorales_rrhh
POSTGRES_USER=postgres
POSTGRES_PASSWORD=DefinirUnaContraseñaMuySegura2026!
POSTGRES_PORT=5432

# ── Seguridad y Autenticación JWT ─────────────────────────────────────────────
JWT_SECRET_KEY=GenerarClaveSecretaAleatoriaDeProduccion2026_TornoMoralesRRHH!

# ── Puertos Expuestos en el Host ──────────────────────────────────────────────
BACKEND_PORT=5076
FRONTEND_PORT=3000

# ── URL Pública de la API para el Cliente Frontend ────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:5076/api

# ── Notificaciones Transaccionales (Resend API) ──────────────────────────────
RESEND_API_KEY=re_tu_api_key_de_resend
RESEND_FROM=onboarding@resend.dev

# ── Notificaciones Fallback (SMTP Gmail) ──────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_app_password
SMTP_FROM=tu_correo@gmail.com

# ── Política de Respaldos y Cifrado ──────────────────────────────────────────
BACKUP_ENCRYPTION_KEY=ClaveDeCifradoAes256ParaRespaldos2026!
