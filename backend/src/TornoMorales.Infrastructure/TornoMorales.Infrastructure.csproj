<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\TornoMorales.Domain\TornoMorales.Domain.csproj" />
    <ProjectReference Include="..\TornoMorales.Application\TornoMorales.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Npgsql.EF 9.0.4 trae transitivamente EF Core 9.0.1 y EF.Relational 9.0.1.
      Declaramos EF Core en la misma versión exacta para evitar conflictos MSB3277.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PreserveCompilationContext>true</PreserveCompilationContext>
  </PropertyGroup>

</Project>
